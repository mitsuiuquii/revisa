{
  "framework": "fastapi",
  "buildCommand": "pip install -r backend/requirements.txt",
  "outputDirectory": ".",
  "functions": {
    "api/**.py": {
      "runtime": "python3.11"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/app.py",
      "status": 404
    }
  ]
}
